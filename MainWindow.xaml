<Window x:Class="Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes" Width="1120" Height="720" MinWidth="720" MinHeight="460"
        Background="{DynamicResource Editor}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="230" MaxWidth="500"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Note list ============ -->
        <Border Grid.Column="0" Background="{DynamicResource Pane}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,12,4">
                    <TextBlock Text="Notes" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE706;"
                                Click="ThemeButton_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New note (Ctrl+N)"
                                Click="NewNote_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="16,8,16,10" Background="{DynamicResource Editor}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                 Padding="10,7" FontSize="13" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Search notes (Ctrl+F)" IsHitTestVisible="False" FontSize="13"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <ListBox x:Name="NotesList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NoteItemStyle}"
                         SelectionChanged="NotesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="&#xE718;" FontSize="11" Margin="8,3,0,0"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{DynamicResource Accent}"
                                               Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Snippet}" FontSize="12.5" Margin="0,4,0,0"
                                           TextWrapping="Wrap" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="34" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Muted}"/>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ModifiedText}" FontSize="11.5"
                                               Foreground="{DynamicResource Muted}" Opacity="0.85"/>
                                    <TextBlock Text="&#xE91B;" FontSize="11.5" HorizontalAlignment="Right"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{DynamicResource Muted}"
                                               Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyList" Grid.Row="2" Visibility="Collapsed" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="28,40,28,0" VerticalAlignment="Top" LineHeight="20"
                           Foreground="{DynamicResource Muted}" FontSize="13"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- ============ Editor ============ -->
        <Grid Grid.Column="2">

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="320">
                <TextBlock Text="No note open" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Pick a note from the list, or start a new one." TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,18" Foreground="{DynamicResource Muted}"/>
                <Button Content="New note" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                        Click="NewNote_Click"/>
            </StackPanel>

            <Grid x:Name="EditorPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="22,12,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FormatButton}" Content="B" FontWeight="Bold"
                                Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}"
                                ToolTip="Bold (Ctrl+B)"/>
                        <Button Style="{StaticResource FormatButton}" Content="I" FontStyle="Italic"
                                Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}"
                                ToolTip="Italic (Ctrl+I)"/>
                        <Button Style="{StaticResource FormatButton}"
                                Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}"
                                ToolTip="Underline (Ctrl+U)">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource Line}" Margin="8,0"/>
                        <Button Style="{StaticResource FormatButton}" Content="&#x2022;"
                                Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}"
                                ToolTip="Bulleted list"/>
                        <Button Style="{StaticResource FormatButton}" Content="1."
                                Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}"
                                ToolTip="Numbered list"/>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource Line}" Margin="8,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE91B;"
                                ToolTip="Insert photo (or just paste one with Ctrl+V)" Click="InsertImage_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                                Click="Pin_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete note"
                                Click="Delete_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Title + body, centred in a readable column -->
                <Grid Grid.Row="1" MaxWidth="820">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="30,20,30,6">
                        <TextBox x:Name="TitleBox" Background="Transparent" BorderThickness="0" Padding="0"
                                 FontSize="28" FontWeight="SemiBold" MaxLength="200"
                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                 TextChanged="TitleBox_TextChanged" PreviewKeyDown="TitleBox_PreviewKeyDown"/>
                        <TextBlock Text="Untitled" FontSize="28" FontWeight="SemiBold" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Muted}" Opacity="0.55">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <RichTextBox x:Name="Editor" Grid.Row="1" Margin="30,6,24,8" Padding="0" BorderThickness="0"
                                 Background="Transparent" FontSize="15"
                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                 SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.35"
                                 AcceptsTab="True" AllowDrop="True" SpellCheck.IsEnabled="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="Editor_TextChanged"
                                 PreviewDragOver="Editor_PreviewDragOver" PreviewDrop="Editor_PreviewDrop">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>

                    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="30,0,30,12" FontSize="11.5"
                               Foreground="{DynamicResource Muted}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
